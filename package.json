    "date-fns": "^4.1.0",
    "firebase": "^12.6.0",
    "framer-motion": "^12.15.0",
    "gsap": "^3.13.0",
    "i18n": "^0.15.1",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.1.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.511.0",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
