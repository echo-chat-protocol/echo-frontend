    "@tauri-apps/cli": "^2.9.4",
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.21",
    "commit-and-tag-version": "^12.6.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
