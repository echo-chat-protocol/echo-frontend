# ECHO Frontend - Production Environment Variables Template
# Copy this file to '.env.production' and configure your actual production values.
# DO NOT commit the finished '.env.production' file with sensitive keys to source control.

# ─── API & BACKEND CONFIGURATION ──────────────────────────────────────────────
# The primary endpoint for all REST API operations (should end with /api/v1)
VITE_API_URL=https://your-production-backend.onrender.com/api/v1

# The backend server URL for WebSockets / Socket.IO signaling
VITE_SOCKET_URL=https://your-production-backend.onrender.com


# ─── THIRD PARTY INTEGRATIONS ─────────────────────────────────────────────────
# KLIPY GIF API key — powers the in-chat GIF picker (search + trending).
# Get a free key at https://klipy.com/developers and paste it below.
# Leave the placeholder to disable the GIF picker gracefully.
VITE_KLIPY_API_KEY=your_klipy_api_key_here
